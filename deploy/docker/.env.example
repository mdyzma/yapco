# Copy to deploy/docker/.env and change what you need; every line is optional.

# The port on your computer (http://localhost:8080).
YAPCO_PORT=8080

# 127.0.0.1: only this computer can open it. 0.0.0.0: other devices in your network too
# (then add the address they use to YAPCO_ORIGIN).
YAPCO_BIND=127.0.0.1

# More addresses people open the site with, comma-separated, so PDF export accepts them, e.g.
# http://192.168.1.20:8080 for your network, or https://planner.example.com behind a tunnel.
YAPCO_ORIGIN=

# Shown in the dashboard's footer. To show the commit instead, set BUILD_SHA in your shell when
# building (docs/operations/deploy.md, A2); a value here is used as it is.
BUILD_SHA=docker
