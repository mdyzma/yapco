{
  "schemaVersion": 1,
  "id": "weekly-planner",
  "version": "1.0.0",
  "name": {
    "en": "Week by Week",
    "pl": "Tydzień po Tygodniu"
  },
  "description": {
    "en": "A simple weekly planner: a month spread with the calendar, goals and important dates, then a spread for each week with the days, three priorities and a to-do list.",
    "pl": "Prosty planer tygodniowy: rozkładówka miesiąca z kalendarzem, celami i ważnymi datami, potem rozkładówka każdego tygodnia z dniami, trzema priorytetami i listą zadań."
  },
  "supportedFormats": [
    "A4",
    "A5"
  ],
  "supportedLocales": [
    "en",
    "pl"
  ],
  "defaults": {
    "print": {
      "profile": "home-duplex",
      "margins": {
        "inner": 18,
        "outer": 14,
        "top": 14,
        "bottom": 17
      },
      "printerSafeMargin": 5,
      "outerRail": 0,
      "bleed": 0,
      "cropMarks": false,
      "binding": {
        "kind": "ring",
        "preset": "iso838-2hole",
        "holeCentreFromEdge": 12,
        "holeDiameter": 6,
        "holePositions": [
          108.5,
          188.5
        ],
        "punchGuides": false
      },
      "pageNumbers": true,
      "brandMark": true,
      "color": "color",
      "calibrationPage": false
    },
    "theme": {},
    "generation": {
      "durationMonths": 12,
      "monthMode": "calendar",
      "weekOwnership": "monday",
      "dailyLayout": "spread",
      "weeklyLayout": "spread",
      "quoteCadence": "none",
      "volumes": 1
    }
  },
  "pageTemplates": {
    "cover": {
      "id": "cover",
      "name": {
        "en": "Cover",
        "pl": "Strona tytułowa"
      },
      "hidePageNumber": true,
      "body": {
        "kind": "stack",
        "gap": 6,
        "children": [
          {
            "kind": "block",
            "block": {
              "id": "top",
              "type": "spacer",
              "props": {},
              "size": {
                "height": {
                  "fr": 1
                }
              }
            }
          },
          {
            "kind": "block",
            "block": {
              "id": "apple",
              "type": "image",
              "props": {
                "src": "data:image/svg+xml;base64,",
                "alt": {
                  "en": "An apple with a tick",
                  "pl": "Jabłko z ptaszkiem"
                }
              },
              "size": {
                "height": {
                  "fr": 2
                }
              }
            }
          },
          {
            "kind": "stack",
            "gap": 1,
            "children": [
              {
                "kind": "block",
                "block": {
                  "id": "title",
                  "type": "text",
                  "props": {
                    "text": {
                      "en": "Week by Week",
                      "pl": "Tydzień po Tygodniu"
                    },
                    "variant": "heading"
                  },
                  "size": {
                    "height": {
                      "mm": 10
                    }
                  }
                }
              },
              {
                "kind": "block",
                "block": {
                  "id": "subtitle",
                  "type": "text",
                  "props": {
                    "text": {
                      "en": "A planner for the weeks ahead",
                      "pl": "Planer na nadchodzące tygodnie"
                    },
                    "variant": "subheading"
                  },
                  "size": {
                    "height": {
                      "mm": 8
                    }
                  }
                }
              }
            ],
            "height": {
              "mm": 20
            }
          },
          {
            "kind": "block",
            "block": {
              "id": "gap",
              "type": "spacer",
              "props": {},
              "size": {
                "height": {
                  "fr": 1
                }
              }
            }
          },
          {
            "kind": "block",
            "block": {
              "id": "owner",
              "type": "writing-area",
              "props": {
                "title": {
                  "en": "This planner belongs to",
                  "pl": "Ten planer należy do"
                },
                "pattern": "lines",
                "pitch": 8
              },
              "size": {
                "height": {
                  "mm": 16
                }
              }
            }
          },
          {
            "kind": "stack",
            "gap": 1.5,
            "children": [
              {
                "kind": "block",
                "block": {
                  "id": "start",
                  "type": "text",
                  "props": {
                    "text": {
                      "en": "{{plannerStartDate}}",
                      "pl": "{{plannerStartDate}}"
                    },
                    "variant": "subheading"
                  }
                }
              }
            ],
            "height": {
              "mm": 16
            },
            "label": {
              "en": "I start on",
              "pl": "Zaczynam dnia"
            }
          },
          {
            "kind": "block",
            "block": {
              "id": "bottom",
              "type": "spacer",
              "props": {},
              "size": {
                "height": {
                  "fr": 1
                }
              }
            }
          }
        ]
      },
      "guide": {
        "en": "The title page: write your name if you like. The start date is printed from the planner settings, or left blank for a planner without dates.",
        "pl": "Strona tytułowa: wpisz swoje imię, jeśli chcesz. Data początku drukuje się z ustawień planera albo zostaje pusta w planerze bez dat."
      },
      "sampleContent": {
        "owner": {
          "fill": "Ola"
        }
      }
    },
    "year": {
      "id": "year",
      "name": {
        "en": "My year",
        "pl": "Mój rok"
      },
      "body": {
        "kind": "stack",
        "gap": 4,
        "children": [
          {
            "kind": "block",
            "block": {
              "id": "heading",
              "type": "text",
              "props": {
                "text": {
                  "en": "My year",
                  "pl": "Mój rok"
                },
                "variant": "heading"
              },
              "size": {
                "height": {
                  "mm": 12
                }
              }
            }
          },
          {
            "kind": "block",
            "block": {
              "id": "goals",
              "type": "numbered-list",
              "props": {
                "title": {
                  "en": "Goals for this year",
                  "pl": "Cele na ten rok"
                },
                "count": 5,
                "marker": "checkbox"
              },
              "size": {
                "height": {
                  "mm": 60
                }
              }
            }
          },
          {
            "kind": "block",
            "block": {
              "id": "remember",
              "type": "writing-area",
              "props": {
                "title": {
                  "en": "What I want to remember this year",
                  "pl": "O czym chcę pamiętać w tym roku"
                },
                "pattern": "lines",
                "framed": true
              },
              "size": {
                "height": {
                  "mm": 40
                }
              }
            }
          },
          {
            "kind": "block",
            "block": {
              "id": "notes",
              "type": "writing-area",
              "props": {
                "title": {
                  "en": "Notes",
                  "pl": "Notatki"
                },
                "pattern": "dots",
                "pitch": 5
              },
              "size": {
                "height": {
                  "fr": 1
                }
              }
            }
          }
        ]
      },
      "guide": {
        "en": "Once, at the start: up to five goals for the year, ticked off as you reach them, and what you want to remember. The dot grid is for anything that belongs to the whole year, such as exam dates or a trip to book.",
        "pl": "Raz, na początku: najwyżej pięć celów na rok, odhaczanych, gdy je osiągniesz, i to, o czym chcesz pamiętać. Kropki są na wszystko, co dotyczy całego roku, np. terminy egzaminów czy wyjazd do zarezerwowania."
      },
      "sampleContent": {
        "goals": {
          "fill": {
            "items": [
              {
                "en": "Pass the evening course",
                "pl": "Zdać kurs wieczorowy"
              },
              {
                "en": "Move to a flat closer to work",
                "pl": "Przeprowadzić się bliżej pracy"
              },
              {
                "en": "Run 5 km without stopping",
                "pl": "Przebiec 5 km bez zatrzymania"
              },
              {
                "en": "Visit grandma once a month",
                "pl": "Odwiedzać babcię raz w miesiącu"
              },
              {
                "en": "Save for a summer trip",
                "pl": "Odłożyć na letni wyjazd"
              }
            ],
            "done": [
              2
            ]
          },
          "note": {
            "en": "tick them off during the year",
            "pl": "odhaczaj w ciągu roku"
          },
          "noteAt": "bottom-right"
        },
        "remember": {
          "fill": {
            "en": "Rest is part of the plan.\nOne big thing at a time.",
            "pl": "Odpoczynek też jest częścią planu.\nJedna duża sprawa naraz."
          }
        },
        "notes": {
          "fill": {
            "en": "course exams: January and June\ntrip: book by March",
            "pl": "egzaminy z kursu: styczeń i czerwiec\nwyjazd: rezerwacja do marca"
          }
        }
      }
    },
    "month-left": {
